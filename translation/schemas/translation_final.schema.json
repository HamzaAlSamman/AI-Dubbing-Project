{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "translation_final/2",
  "title": "Translation step output (hand-off to the TTS stage)",
  "description": "One record per translation unit. A unit may be derived from several original source units (merge); every original unit keeps its id, text, timestamps and word alignment in source_units. natural_ar is the written dubbing line; tts_text is the spoken form of it (separate string).",
  "type": "object",
  "required": ["schema_version", "run_id", "config_sha256", "tasks_sha256", "created_at", "units"],
  "properties": {
    "schema_version": {"const": "translation_final/2"},
    "run_id": {"type": "string"},
    "config_sha256": {"type": "string"},
    "tasks_sha256": {"type": "string"},
    "source_tasks_sha256": {"type": "string"},
    "git_commit": {"type": ["string", "null"]},
    "created_at": {"type": "string"},
    "human_approved": {"type": "boolean"},
    "degraded": {"type": "boolean"},
    "units": {"type": "array", "items": {"$ref": "#/$defs/unit"}}
  },
  "$defs": {
    "source_unit": {
      "type": "object",
      "required": ["unit_id", "source_text", "start", "end", "words"],
      "properties": {
        "unit_id": {"type": "string"},
        "source_text": {"type": "string"},
        "start": {"type": ["number", "null"]},
        "end": {"type": ["number", "null"]},
        "words": {"type": ["array", "null"]}
      }
    },
    "unit": {
      "type": "object",
      "required": ["unit_id", "derived", "merged_from", "source_units", "source_text", "source_flags", "status",
                   "natural_ar", "accurate_ar", "tts_text", "spoken_version", "start", "end", "slot_s",
                   "window_s", "provenance", "flags"],
      "properties": {
        "unit_id": {"type": "string"},
        "derived": {"type": "boolean"},
        "merged_from": {"type": ["array", "null"], "items": {"type": "string"}},
        "source_units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_unit"}},
        "source_text": {"type": "string"},
        "source_flags": {"type": "object"},
        "status": {"enum": ["accepted", "accepted_after_refine", "needs_review", "missing"]},
        "natural_ar": {"type": ["string", "null"]},
        "accurate_ar": {"type": ["string", "null"]},
        "tts_text": {"type": ["string", "null"]},
        "spoken_version": {"type": "string"},
        "start": {"type": ["number", "null"]},
        "end": {"type": ["number", "null"]},
        "slot_s": {"type": "number"},
        "window_s": {"type": "number"},
        "predicted_s": {"type": ["number", "null"]},
        "provenance": {
          "type": "object",
          "required": ["cand_id", "generator", "prompt_sha", "generator_info"],
          "properties": {
            "cand_id": {"type": ["string", "null"]},
            "generator": {"type": ["string", "null"]},
            "prompt_sha": {"type": ["string", "null"]},
            "generator_info": {"type": ["object", "null"]},
            "refined_from": {"type": ["string", "null"]},
            "polished_from": {"type": ["string", "null"]}
          }
        },
        "flags": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
